# OpenAI API Key for Whisper transcription
OPENAI_API_KEY=sk-your-openai-api-key

# Resend API Key for email notifications
# Get one at https://resend.com
RESEND_API_KEY=re_your-resend-api-key

# Email to receive notifications
NOTIFICATION_EMAIL=hello@katiep.me

# Admin secret for viewing submissions
ADMIN_SECRET=your-secret-password

# --- Families 101 funnel (/families, /families/thanks, /families/101, /families/guide) ---
# Kit (Settings > Developer > API v4 key)
KIT_API_KEY=kit_your-v4-api-key
KIT_FORM_ID=1234567
KIT_BUYER_TAG_ID=1234567
# Stripe payment link for the $27 product, and its id (plink_...)
FAMILIES_PAYMENT_LINK=https://buy.stripe.com/your-link
FAMILIES_PAYMENT_LINK_ID=plink_your-link-id
# Signing secret of the webhook endpoint pointed at /api/families-stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_your-secret
